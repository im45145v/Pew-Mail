# ==============================================================================
# PEE MAIL - ENVIRONMENT VARIABLES
# ==============================================================================

# Environment Configuration
ENVIRONMENT=development  # development, staging, production

# Database Configuration
POSTGRES_DB=pewmail
POSTGRES_USER=pewmail
POSTGRES_PASSWORD=pewmail_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Secret Key for JWT tokens and password hashing (also used for token encryption)
# Generate a secure key in production: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_change_in_production

# AI Provider Configuration
AI_PROVIDER_URL=https://api.openai.com/v1
AI_API_KEY=your_api_key_here

# Google OAuth Configuration (required for Gmail integration)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173

# Backend Configuration
BACKEND_PORT=8000

# Mailpit Configuration (Development Email Testing)
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Application URLs
BACKEND_API_URL=http://localhost:${BACKEND_PORT}
FRONTEND_API_URL=http://localhost:${FRONTEND_PORT}

# Security Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or text

# Redis Configuration (for background jobs - if implemented)
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
STORAGE_TYPE=local  # local, s3
STORAGE_LOCAL_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=

# Billing Provider Configuration (Stripe/Razorpay)
BILLING_PROVIDER=mock  # mock, stripe, razorpay
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Usage Limits (per organization per month)
AI_QUOTA_LIMIT=10000  # tokens
AI_DAILY_RATE_LIMIT=1000  # requests per day

# Organization Limits
MAX_PROJECTS_PER_ORGANIZATION=10
MAX_TEMPLATES_PER_ORGANIZATION=100
MAX_CONTACTS_PER_ORGANIZATION=10000
MAX_EMAIL_CAMPAIGNS_PER_ORGANIZATION=100

# Email Sending Limits
MAX_TEST_SENDS_PER_DAY=50
MAX_PRODUCTION_SENDS_PER_DAY=1000

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif,.svg

# Background Jobs Configuration
WORKER_CONCURRENCY=4
WORKER_MAX_TASKS_PER_CHILD=1000